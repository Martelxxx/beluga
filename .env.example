# Server-side only. Never place these keys in the HTML.
AVIATIONSTACK_KEY=
WEATHERAPI_KEY=
OPENAI_API_KEY=
DUFFEL_ACCESS_TOKEN=

# RouteStack hotel search/booking (server-side only).
ROUTESTACK_API_KEY=
ROUTESTACK_API_SECRET=
# Optional direct partner bearer token. If set, login is skipped.
ROUTESTACK_PARTNER_TOKEN=
ROUTESTACK_BASE_URL=https://mcp.routestack.ai


# Optional model overrides.
BELUGA_TRANSLATION_MODEL=gpt-4o-mini
BELUGA_ROUTER_MODEL=gpt-5.4-mini
BELUGA_CHAT_MODEL=gpt-5.4-mini
BELUGA_TTS_MODEL=gpt-4o-mini-tts
BELUGA_TTS_VOICE=coral
BELUGA_PORT=8790
